# The RunPod upload archive: ~5.1 GB, far over GitHub's 100 MB push limit, and
# fully reproducible from dataset/bundle/ by prepare_runpod_bundle.py + tar.
# Same reasoning as the *.pt rule above -- a stray `git add .` here would build a
# commit that cannot be pushed and has to be unpicked from history.
dataset/bundle.tar
dataset/v2b_labels.tar.gz
dataset/bundle.tar.*


# Keep folder structure
!dataset/raw/.gitkeep
!dataset/processed/.gitkeep
!dataset/curated/.gitkeep
!dataset/merged/.gitkeep
!dataset/final/.gitkeep

# Reports generated automatically
dataset/reports/*.csv
dataset/reports/*.json
dataset/reports/*.txt

# ==========================
# Training outputs
# ==========================

runs/
wandb/
tensorboard/

# ==========================
# Models
# ==========================

# Downloaded COCO checkpoints used as PROXY MODELS for FiftyOne review overlays
# (DEC-106) -- not training outputs, and reproducible in seconds by ultralytics
# on first use. Ignored because notebooks/yolov8x.pt is 136 MB and GitHub rejects
# any file over 100 MB on push, so a stray `git add .` would create a commit that
# cannot be pushed and has to be unpicked from history.
*.pt
*.onnx
*.hef

models/weights/
models/onnx/
models/hef/
models/archived/

!models/current/
!models/current/README.md

# Deployment kits: a frozen best.pt plus its full INT8 calibration set (~715 MB
# of JPEGs for cap4500). Same reasoning as the *.pt and bundle.tar rules -- far
# too large for git, and fully reproducible from the run directory plus
# dataset/bundle. models/current/README.md carries the tracked pointer to where
# each kit actually lives (GitHub Release asset + network volume).
models/current/deployment_kit_*/

# The upload archive of a kit (scripts/train/build_deployment_kit_v2.py --tar).
# 700 MB, and a pure function of the kit directory above -- rebuild, never commit.
v2_kit.tar.gz
# The skeleton upload (kit minus the images/weights sourced from the network
# volume). Regenerated by scripts/train/stage_kit_skeleton.py.
v2_kit_skeleton.tar.gz

